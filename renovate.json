{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "hostRules": [
    {
      "matchHost": "registry1.dso.mil",
      "hostType": "docker",
      "username": "{{ secrets.REGISTRY1_USERNAME }}",
      "password": "{{ secrets.REGISTRY1_PASSWORD }}"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/Chart\\.yaml$/"],
      "matchStrings": ["appVersion: \"(?<currentValue>[^\"]+)\""],
      "autoReplaceStringTemplate": "appVersion: \"{{newValue}}\"",
      "depNameTemplate": "registry1.dso.mil/ironbank/radiusmethod/socketzero/receiver",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/Chart\\.yaml$/"],
      "matchStrings": ["\\nversion: (?<currentValue>\\S+)"],
      "autoReplaceStringTemplate": "\nversion: {{newValue}}",
      "depNameTemplate": "registry1.dso.mil/ironbank/radiusmethod/socketzero/receiver",
      "datasourceTemplate": "docker"
    }
  ]
}
